# PostPulse Studio + GrowthCrew Outreach — env placeholders only (never commit real secrets)

# Server
PORT=3005

# Captions (PostPulse Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Media uploads (optional; JSON fallback without credentials)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-southeast-2
S3_BUCKET=in2peta-postiz-media

# Postiz publish engine (optional; often http://localhost:4007)
POSTIZ_API_URL=http://localhost:4007/api/public/v1
POSTIZ_API_KEY=

# GrowthCrew outreach (leave blank to run PostPulse studio without sending)
CORECLAW_API_KEY=
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
CENTRAL_INBOX=in2peta@gmail.com
PHYSICAL_ADDRESS=
UNSUBSCRIBE_URL=
CAMPAIGN_CONCURRENCY=10
MAX_SENDS_PER_INBOX=200
LITELLM_BASE_URL=https://code.in2peta.com/v1
LITELLM_MASTER_KEY=

# GrowthCrew lead database (MotherDuck — ~10.6M USA business leads).
# Merged with CoreClaw live search. Leave MOTHERDUCK_TOKEN empty to disable.
MOTHERDUCK_TOKEN=
MOTHERDUCK_DATABASE=business_leads
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
API_KEY_ENCRYPTION_KEY=
